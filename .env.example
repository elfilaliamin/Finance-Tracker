# Database Credentials
POSTGRES_DB=financetracker
POSTGRES_USER=ft_user
POSTGRES_PASSWORD=replace_with_a_secure_postgres_password

# Authentication Secrets
JWT_SECRET=replace_with_a_long_random_jwt_secret_key_minimum_32_characters

# Default Initial Administrator
ADMIN_EMAIL=admin@financetracker.local
ADMIN_PASSWORD=replace_with_a_strong_admin_password_min_8_chars

# Port Configuration
# The host port where the frontend web application is published (default: 3004)
PORT=3004

# Application Settings
NODE_ENV=production
TRUST_PROXY=1
